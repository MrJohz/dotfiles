# Fail loudly rather than fall back. Without this Sunshine drops to the XDG
# portal when KMS capture finds no monitor, and the portal path hangs forever
# on a headless autologin box waiting for a consent dialog nobody can click —
# the service reports `active` and never opens its ports.
capture = kms

# Left to itself Sunshine probes Vulkan before VAAPI and picks it, which on
# RADV produces a visibly soft, blocky picture. The giveaway in the log is the
# signalled level: hevc_vulkan claimed HEVC 3.1, whose maximum picture size is
# 983,040 luma samples — a 1920x1080 frame is 2,073,600. Decoders are lenient
# enough to play it anyway, so this never surfaces as an error, only as bad
# pictures. VAAPI drives the same VCN hardware with real VBR rate control.
#
# Worth re-testing after Mesa updates; RADV's Vulkan encode is improving and
# this override may stop being necessary.
encoder = vaapi

# Sunshine >= 2026.428 rejects web-UI requests whose Origin is not listed here
# (default: localhost only), which surfaces confusingly as pairing failures.
# localhost covers the scripted pairing flow in the README runbook.
csrf_allowed_origins = https://localhost:47990,https://{{ vars.hostname }}:47990

# [An LLM generated the following paragraph.]
#
# Sunshine >= 2026.906 draws the tray with Qt. The brew bottle resolves no Qt
# plugin path — the log reads `Could not find the Qt platform plugin "wayland"
# in ""` — and the cap_sys_admin setcap puts the binary in secure-execution
# mode, where QT_QPA_PLATFORM_PLUGIN_PATH is discarded, so the path cannot come
# from the environment either. Qt then calls qFatal, and the unit dies with
# SIGABRT after KMS capture and the encoders have already come up. See
# LizardByte/Sunshine#5170, which is also where this workaround comes from.
system_tray = disabled
