# Machine-local inputs for remote-desktop/setup-sunshine.sh.
#
# This file's existence is also what tells the script the feature is configured
# here: without it `--check` exits quietly and `--ensure` refuses. That is what
# keeps the feature zero-cost on every other machine.
RDS_CONNECTOR={{ vars.remote_desktop_connector }}
RDS_MODE={{ vars.remote_desktop_mode }}
RDS_USER={{ vars.remote_desktop_user }}
