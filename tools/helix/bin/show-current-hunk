#!/usr/bin/env python3

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

HUNK_RE = re.compile(
    r"^@@ -(?P<old_start>\d+)(?:,(?P<old_count>\d+))? "
    r"\+(?P<new_start>\d+)(?:,(?P<new_count>\d+))? @@"
)


def run(cmd, *, check_codes=(0,), cwd=None):
    result = subprocess.run(
        cmd,
        cwd=cwd,
        capture_output=True,
        text=True,
    )
    if result.returncode not in check_codes:
        msg = result.stderr.strip() or f"command failed: {' '.join(cmd)}"
        print(msg)
        sys.exit(1)
    return result.stdout


def git_root_for(path: Path) -> Path:
    out = run(
        ["git", "-C", str(path.parent), "rev-parse", "--show-toplevel"],
        check_codes=(0,),
    ).strip()
    return Path(out)


def is_untracked(root: Path, relpath: str) -> bool:
    out = run(
        ["git", "-C", str(root), "ls-files", "--others", "--exclude-standard", "--", relpath],
        check_codes=(0,),
    ).strip()
    return bool(out)


def diff_text(mode: str, abs_path: Path, root: Path, relpath: str) -> str:
    if mode == "staged":
        return run(
            ["git", "-C", str(root), "diff", "--no-ext-diff", "--no-color", "--cached", "--unified=0", "--", relpath],
            check_codes=(0,),
        )
    if mode == "unstaged":
        text = run(
            ["git", "-C", str(root), "diff", "--no-ext-diff", "--no-color", "--unified=0", "--", relpath],
            check_codes=(0,),
        )
        if text:
            return text
        if is_untracked(root, relpath):
            return run(
                ["git", "diff", "--no-index", "--no-color", "--unified=0", "--", "/dev/null", str(abs_path)],
                check_codes=(0, 1),
            )
        return ""

    text = run(
        ["git", "-C", str(root), "diff", "--no-ext-diff", "--no-color", "--unified=0", "HEAD", "--", relpath],
        check_codes=(0,),
    )
    if text:
        return text
    if is_untracked(root, relpath):
        return run(
            ["git", "diff", "--no-index", "--no-color", "--unified=0", "--", "/dev/null", str(abs_path)],
            check_codes=(0, 1),
        )
    return ""


def parse_hunks(text: str):
    header = []
    hunks = []
    current = None

    for line in text.splitlines():
        m = HUNK_RE.match(line)
        if m:
            if current is not None:
                hunks.append(current)

            old_start = int(m.group("old_start"))
            old_count = int(m.group("old_count") or "1")
            new_start = int(m.group("new_start"))
            new_count = int(m.group("new_count") or "1")

            current = {
                "header": header[:],
                "body": [format_hunk_header(old_start, old_count, new_start, new_count)],
                "new_start": new_start,
                "new_count": new_count,
            }
            continue

        if current is None:
            header.append(line)
        else:
            current["body"].append(line)

    if current is not None:
        hunks.append(current)

    return hunks


def format_hunk_header(old_start: int, old_count: int, new_start: int, new_count: int) -> str:
    return f"@@ -{format_hunk_range(old_start, old_count)} +{format_hunk_range(new_start, new_count)} @@"


def format_hunk_range(start: int, count: int) -> str:
    if count == 1:
        return str(start)
    return f"{start},{count}"


def line_in_hunk(cursor_line: int, new_start: int, new_count: int) -> bool:
    if new_count == 0:
        return cursor_line == new_start or cursor_line == new_start + 1
    return new_start <= cursor_line <= (new_start + new_count - 1)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--mode", choices=("head", "staged", "unstaged"), default="head")
    parser.add_argument("file")
    parser.add_argument("line", type=int)
    args = parser.parse_args()

    if args.file == "[scratch]":
        print("Current buffer is not file-backed.")
        return

    abs_path = Path(args.file).expanduser()
    if not abs_path.is_absolute():
        abs_path = (Path.cwd() / abs_path).resolve()

    if not abs_path.exists():
        print(f"File does not exist: {abs_path}")
        return

    try:
        root = git_root_for(abs_path)
    except SystemExit:
        print("Not inside a git repository.")
        return

    try:
        relpath = os.path.relpath(abs_path, root)
    except ValueError:
        print("Current file is outside the git repository.")
        return

    text = diff_text(args.mode, abs_path, root, relpath)
    if not text.strip():
        print("No uncommitted changes for this file.")
        return

    hunks = parse_hunks(text)
    for hunk in hunks:
        if line_in_hunk(args.line, hunk["new_start"], hunk["new_count"]):
            output = "\n".join(hunk["body"])
            print(output)
            return

    print("No changed hunk at cursor.")


if __name__ == "__main__":
    main()
