#!/usr/bin/env bash
# Minimal secret store for the bootstrap process.
#
# Not a password manager. It exists so `mise apply` can render a secret into a
# config file without re-prompting on every run — Bitwarden stays the record of
# truth, this is only a cache. Hence three verbs and no rotation: re-keying a
# restic repository is `restic key passwd`, and editing the cache alone would
# just lock you out of it.
#
# `get` is called from a mise template, so stdout carries the value and nothing
# else — prompts and errors go to the tty and stderr. Templates are also
# rendered by `mise bootstrap status`, which fish's greeting runs hourly, so
# `get` must never prompt and never block.
set -euo pipefail

store="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/secrets"

die() {
    printf '%s: %s\n' "${0##*/}" "$1" >&2
    exit 1
}

# Names index the store by filename, so a path separator would escape it and a
# leading dot would hide the entry (or name `.`/`..`).
check_name() {
    case "${1-}" in
        "") die "missing secret name" ;;
        .*) die "invalid secret name: ${1}" ;;
        *[!A-Za-z0-9._-]*) die "invalid secret name: ${1}" ;;
    esac
}

prompt_into() {
    local name="$1" value
    # Opening the tty is the real test; /dev/tty exists even with no
    # controlling terminal, and we must fail rather than hang.
    { true >/dev/tty; } 2>/dev/null ||
        die "no terminal available to prompt for '$name'"

    printf 'Enter secret %s: ' "$name" >/dev/tty
    IFS= read -rs value </dev/tty || die "could not read '$name'"
    printf '\n' >/dev/tty

    [ -n "$value" ] || die "'$name' must not be empty"

    mkdir -p "$store"
    chmod 700 "$store"
    (umask 077; printf '%s' "$value" >"$store/$name")
}

cmd_ensure() {
    check_name "${1-}"
    [ -s "$store/$1" ] && return 0
    prompt_into "$1"
}

cmd_get() {
    local value
    check_name "${1-}"
    [ -r "$store/$1" ] || die "no secret '$1' cached — run: mise apply"
    # $() strips trailing newlines, which would otherwise land in the rendered
    # file. The emptiness check is load-bearing: mise writes exec() output
    # verbatim and does not object to an empty string, so a silent empty here
    # would become an empty password on disk.
    value=$(cat "$store/$1")
    [ -n "$value" ] || die "secret '$1' is empty"
    printf '%s' "$value"
}

cmd_clear() {
    # Guard the computed path: with HOME and XDG_STATE_HOME both unset this
    # would otherwise expand somewhere unintended.
    case "$store" in
        /*/dotfiles/secrets) ;;
        *) die "refusing to clear implausible store path: $store" ;;
    esac

    [ -d "$store" ] || { echo "no secrets cached"; return 0; }
    rm -rf -- "$store"
    echo "cleared $store"
}

case "${1-}" in
    ensure) shift; cmd_ensure "${1-}" ;;
    get)    shift; cmd_get "${1-}" ;;
    clear)  shift; cmd_clear ;;
    *)      die "usage: ${0##*/} {ensure <name>|get <name>|clear}" ;;
esac
